# Copy to .dev.vars for `wrangler dev`, or run `wrangler secret put <NAME>`.
# Leave these empty in git. Never commit real tokens, workspace IDs, or notes.

# Slack app (Event Subscriptions URL: https://<worker>/slack/events)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Channel that receives a short notice when a new note is synced.
SLACK_SUMMARY_CHANNEL=

# Notion integration with read access to one meeting-notes database.
# Supported properties: a title, a date, and a status/select
# (reviewed | needs-review). Missing status is treated as needs-review.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_VERSION=2022-06-28

# Optional. When set, synced notes are also written to this repo via the
# GitHub contents API so citations can link to a file.
GITHUB_TOKEN=
GITHUB_REPO=beyejin/team-brain

# Public base used in citation links. This sample repo is the default.
NOTES_REPO_URL=https://github.com/beyejin/team-brain
