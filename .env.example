# Empty placeholders. Never commit real tokens, workspace IDs, or page IDs.
# Notion import reads NOTION_TOKEN from the environment or from the
# NOTION_TOKEN Actions secret. Data source IDs live in integrations/notion/config.json.

NOTION_TOKEN=

# Slack worker. Copy the same keys into integrations/slack/.dev.vars.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
SLACK_MEETING_CHANNEL_ID=
SLACK_MEETING_START_DATE=
NOTION_DATA_SOURCE_ID=
